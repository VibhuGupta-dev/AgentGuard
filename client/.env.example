# ==========================================
# AgentCI Frontend Environment Configuration
# ==========================================

# 1. Backend API URL
# The base URL pointing to the AgentCI Express server API.
# For local development: http://localhost:5000/api
# For production: https://your-backend-api.com/api
VITE_API_URL=http://localhost:5000/api

# 2. WebSocket URL
# The root URL pointing to the AgentCI Express server for Socket.IO connections.
# Note: Do not include the '/api' suffix here.
# For local development: http://localhost:5000
# For production: https://your-backend-api.com
VITE_SOCKET_URL=http://localhost:5000
