# ==========================================
# AgentCI Backend Environment Configuration
# ==========================================

# 1. Server Configuration
# The port on which the Express.js server will run. (Default: 5000)
PORT=5000

# Specifies the environment mode (development, staging, production)
NODE_ENV=development

# 2. Database Configuration
# The MongoDB connection string. 
# For local testing, use: mongodb://localhost:27017/agentci
# For production/deployment, use a MongoDB Atlas URI (e.g., mongodb+srv://<user>:<password>@cluster...)
MONGO_URI=mongodb://localhost:27017/agentci

# 3. Security & Authentication
# Secret key used to sign JWT tokens for user authentication.
# In production, use a strong, randomly generated string (e.g., via `openssl rand -hex 32`)
JWT_SECRET=super_secret_agentci_jwt_key_12345

# 4. Client URL (CORS & Socket.IO)
# The URL where your frontend is hosted. Required for CORS policy and WebSocket allowed origins.
# For local development: http://localhost:5173
# For production: https://your-frontend-domain.com
CLIENT_URL=http://localhost:5173

# 5. AI Integrations
# Your Google Gemini API Key. This is required for Dynamic Scenario Generation and the Sandbox Executor.
# Get one from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 6. Advanced Testing (Optional)
# If set to 'true', the backend will bypass the Gemini API and force the Fallback Simulator for all tests.
# This is useful for rapid UI testing without exhausting your rate limits.
# FORCE_MOCK_MODE=false
